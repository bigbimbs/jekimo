# Copy to .env and edit. Every value here is a placeholder or a documented
# default; never commit a real .env. Settings are described in
# docs/configuration.md and in the spec each group links to.
#
# Variables set to their default can be left as they are or deleted.
# Variables left empty are unset.

# Local development stack, see docs/local-development.md
# Read by deploy/docker-compose/docker-compose.dev.yml and by the API, worker,
# and `npm run migrate` when run outside Docker. Not for production.

# Password of the local PostgreSQL container; local-only placeholder.
POSTGRES_PASSWORD=change-me-local-only
# PostgreSQL connection string, used by `npm run migrate` and by the API and
# worker when run outside Docker; the password must match POSTGRES_PASSWORD.
# DATABASE_URL is still read when this is unset, but is deprecated.
JEKIMO_DATABASE_URL=postgres://jekimo:change-me-local-only@127.0.0.1:5432/jekimo
# Loopback port PostgreSQL is published on.
JEKIMO_DEV_POSTGRES_PORT=5432
# Loopback port the API is published on.
JEKIMO_DEV_API_PORT=8080

# Database, API, queue, and worker, see docs/configuration.md

# Maximum database connections per process.
JEKIMO_DATABASE_POOL_MAX=10
# Where migration files are read from; defaults to packages/storage-postgres/migrations.
# JEKIMO_MIGRATIONS_DIR=
# API listen address (the container image sets 0.0.0.0).
JEKIMO_API_HOST=127.0.0.1
# API listen port.
JEKIMO_API_PORT=8080
# Log level: fatal, error, warn, info, debug, or trace.
JEKIMO_LOG_LEVEL=info
# Trust X-Forwarded-For from a reverse proxy you control.
JEKIMO_TRUST_PROXY=false
# Attempts before a queued ingest job is dead-lettered.
JEKIMO_QUEUE_MAX_ATTEMPTS=5
# Seconds a claimed job is hidden from other workers before redelivery.
JEKIMO_QUEUE_VISIBILITY_SECONDS=60
# Jobs the worker claims per poll.
JEKIMO_WORKER_BATCH_SIZE=10
# Milliseconds between polls when the queue is empty.
JEKIMO_WORKER_POLL_MS=1000
# Minutes between expiry passes, 1 to 15.
JEKIMO_EXPIRY_INTERVAL_MINUTES=15
# Apply pending migrations when the API and worker start.
JEKIMO_MIGRATE_ON_START=false
# Pending and running ingest jobs before ingestion answers 503.
JEKIMO_QUEUE_MAX_DEPTH=10000

# Retention and disk safety, see docs/retention.md

# Retention in days for new projects.
JEKIMO_RETENTION_DEFAULT_DAYS=30
# Upper bound in days project admins can set.
JEKIMO_RETENTION_MAX_DAYS=3650
# Free disk space percentage that raises a warning (planned).
JEKIMO_DISK_WARN_PERCENT=20
# Free disk space percentage that starts emergency expiry (planned).
JEKIMO_DISK_CRITICAL_PERCENT=10
# Free disk space percentage at which ingestion is refused (planned).
JEKIMO_DISK_FULL_PERCENT=5
# Audit log retention in days.
JEKIMO_AUDIT_LOG_DAYS=365

# Access model, see docs/access-model.md

# Whether instance members, not only admins, may create projects.
JEKIMO_MEMBERS_CAN_CREATE_PROJECTS=true
# Session idle timeout in days, at most JEKIMO_SESSION_MAX_DAYS.
JEKIMO_SESSION_IDLE_DAYS=14
# Session absolute lifetime in days.
JEKIMO_SESSION_MAX_DAYS=30
# Invitation and password reset link lifetime in days.
JEKIMO_INVITE_EXPIRY_DAYS=7
# Address the dashboard is served on, used in invitation and reset links; empty gives paths.
JEKIMO_PUBLIC_URL=
# Hours a rotated ingestion key keeps working, see docs/ingestion-protocol.md.
JEKIMO_KEY_ROTATION_GRACE_HOURS=24
# SMTP URL; when set, invitations and resets are emailed (planned).
JEKIMO_SMTP_URL=

# Object storage, see docs/object-storage.md
# Phase 2: these variables are unused in Phase 1.

# s3://bucket/prefix or file:///path; empty disables the cold tier, bucket backups, and bucket exports.
JEKIMO_OBJECT_STORE_URL=
# S3 endpoint, for example https://s3.example.com; empty uses the provider default.
JEKIMO_OBJECT_STORE_ENDPOINT=
# S3 region.
JEKIMO_OBJECT_STORE_REGION=auto
# Object storage access key id.
# secret, never commit a real value
JEKIMO_OBJECT_STORE_ACCESS_KEY_ID=
# Object storage secret access key.
# secret, never commit a real value
JEKIMO_OBJECT_STORE_SECRET_ACCESS_KEY=
# Use path-style bucket addressing.
JEKIMO_OBJECT_STORE_PATH_STYLE=true
# Hot period in days for new projects when a bucket is configured.
JEKIMO_HOT_DAYS_DEFAULT=14
# Upper bound in days on a project's hot period.
JEKIMO_HOT_DAYS_MAX=365
# Days that can be restored in one request.
JEKIMO_RESTORE_MAX_DAYS=31
# Days restored partitions stay hot.
JEKIMO_RESTORE_TTL_DAYS=7
# Daily backups kept.
JEKIMO_BACKUP_KEEP_DAILY=14
# Monthly backups kept.
JEKIMO_BACKUP_KEEP_MONTHLY=6
