# Copy to .env for local development. Every value here is a placeholder;
# never commit a real .env. All settings are described in
# docs/configuration.md.

# Password for the local PostgreSQL in deploy/docker-compose/docker-compose.dev.yml.
POSTGRES_PASSWORD=change-me-local-only

# Used by `npm run migrate` and by the API and worker when run outside Docker.
DATABASE_URL=postgres://jekimo:change-me-local-only@127.0.0.1:5432/jekimo

# Host ports for the dev stack (loopback only).
# JEKIMO_DEV_POSTGRES_PORT=5432
# JEKIMO_DEV_API_PORT=8080

# API
# JEKIMO_API_HOST=127.0.0.1
# JEKIMO_API_PORT=8080
# JEKIMO_LOG_LEVEL=info
# JEKIMO_TRUST_PROXY=false
# JEKIMO_MEMBERS_CAN_CREATE_PROJECTS=true
# JEKIMO_SESSION_IDLE_DAYS=14
# JEKIMO_SESSION_MAX_DAYS=30
# JEKIMO_RETENTION_DEFAULT_DAYS=30
# JEKIMO_RETENTION_MAX_DAYS=3650

# Queue and worker
# JEKIMO_QUEUE_MAX_ATTEMPTS=5
# JEKIMO_QUEUE_VISIBILITY_SECONDS=60
# JEKIMO_WORKER_BATCH_SIZE=10
# JEKIMO_WORKER_POLL_MS=1000
# JEKIMO_EXPIRY_INTERVAL_MINUTES=15
# JEKIMO_DATABASE_POOL_MAX=10
