{
  "name": "jekimo",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, self-hosted error, crash, and log observability for backend services",
  "license": "Apache-2.0",
  "homepage": "https://github.com/bigbimbs/jekimo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigbimbs/jekimo.git"
  },
  "bugs": {
    "url": "https://github.com/bigbimbs/jekimo/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
