# Production settings for deploy/docker-compose/docker-compose.yml.
# Copy to .env next to the Compose file, fill in the required values, and keep
# it private: chmod 600 .env. Never commit a real .env.
# Every setting is described in docs/configuration.md; the walkthrough is
# docs/install-vps.md.

# --- Required ---------------------------------------------------------------

# Exact Jekimo release to run, without the leading v. Do not use latest or edge.
JEKIMO_VERSION=0.0.0
# Public host name. DNS must point at this server; Caddy gets its certificate.
JEKIMO_DOMAIN=jekimo.example.com

# --- Database: pick one -----------------------------------------------------

# Option 1, local PostgreSQL in this Compose project.
# Generate both passwords with: openssl rand -hex 32
# (hex keeps them safe to place in a connection string).
COMPOSE_PROFILES=local-db
# Password of the restricted application account `jekimo` that the API,
# worker, and migrations use.
JEKIMO_DB_PASSWORD=
# PostgreSQL superuser password, used only to initialise an empty volume on the
# first start; the init script then removes it from the database. You can
# delete this line after the first successful start.
POSTGRES_ADMIN_PASSWORD=

# Option 2, an existing PostgreSQL server. Set COMPOSE_PROFILES= (empty),
# leave the two passwords above empty, and give the restricted application
# account's connection string. See docs/database-setup.md.
# JEKIMO_DATABASE_URL=postgres://jekimo:<password>@db.example.com:5432/jekimo?sslmode=verify-full

# --- Optional, with their defaults ------------------------------------------

# JEKIMO_LOG_LEVEL=info
# JEKIMO_DATABASE_POOL_MAX=10
# JEKIMO_MEMBERS_CAN_CREATE_PROJECTS=true
# JEKIMO_SESSION_IDLE_DAYS=14
# JEKIMO_SESSION_MAX_DAYS=30
# JEKIMO_RETENTION_DEFAULT_DAYS=30
# JEKIMO_RETENTION_MAX_DAYS=3650
# JEKIMO_QUEUE_MAX_ATTEMPTS=5
# JEKIMO_QUEUE_MAX_DEPTH=10000
# JEKIMO_QUEUE_VISIBILITY_SECONDS=60
# JEKIMO_WORKER_BATCH_SIZE=10
# JEKIMO_WORKER_POLL_MS=1000
# JEKIMO_EXPIRY_INTERVAL_MINUTES=15
