# See docs/install-vps.md.

{$JEKIMO_DOMAIN} {
	encode zstd gzip

	# Ingestion bodies are limited to 1 MiB (docs/ingestion-protocol.md).
	request_body {
		max_size 2MB
	}

	# Readiness names internal dependencies; keep it off the internet.
	handle /readyz {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /healthz {
		reverse_proxy api:8080
	}

	# Everything else is the dashboard, a single-page app.
	handle {
		reverse_proxy web:8080
	}
}
