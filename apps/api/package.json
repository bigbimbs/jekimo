{
  "name": "@jekimo/api",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@jekimo/source src/main.ts",
    "start": "node dist/main.mjs",
    "cli": "tsx --conditions=@jekimo/source src/cli.ts",
    "build": "node ../../scripts/build-app.mjs apps/api main=src/main.ts cli=src/cli.ts migrate=../../packages/storage-postgres/src/migrate-cli.ts",
    "typecheck": "tsc -b",
    "test": "vitest run --root ../.. apps/api"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@jekimo/event-schema": "0.1.0",
    "@jekimo/storage-postgres": "0.1.0",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8"
  }
}
