{
  "name": "@jekimo/worker",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@jekimo/source src/main.ts",
    "start": "node dist/main.mjs",
    "build": "node ../../scripts/build-app.mjs apps/worker main=src/main.ts",
    "typecheck": "tsc -b test bench",
    "bench": "tsx --conditions=@jekimo/source bench/throughput.ts",
    "test": "vitest run --root ../.. apps/worker"
  },
  "dependencies": {
    "@jekimo/event-schema": "0.1.0",
    "@jekimo/storage-postgres": "0.1.0",
    "pino": "^10.4.0"
  }
}
