# Serves the built dashboard on :8080 inside the jekimo-web image. TLS and the
# public address belong to the front proxy (deploy/docker-compose/Caddyfile).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode zstd gzip

	header {
		# Every asset is bundled, so the browser may only contact this origin
		# (docs/architecture.md, "Dashboard"). Radix sets inline style attributes.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Extra routes for a deployment, for example the dev stack's API proxy.
	import /etc/caddy/conf.d/*.caddy

	handle /healthz {
		respond "ok" 200
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
