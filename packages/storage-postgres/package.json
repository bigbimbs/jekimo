{
  "name": "@jekimo/storage-postgres",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@jekimo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./memory": {
      "@jekimo/source": "./src/memory/index.ts",
      "types": "./dist/memory/index.d.ts",
      "default": "./dist/memory/index.js"
    },
    "./testing": {
      "@jekimo/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "migrate": "tsx --conditions=@jekimo/source src/migrate-cli.ts",
    "typecheck": "tsc -b test",
    "test": "vitest run --root ../.. packages/storage-postgres"
  },
  "dependencies": {
    "@jekimo/event-schema": "0.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
